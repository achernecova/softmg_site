# Текущее окружение (development/stage/production)
ENVIRONMENT=stage

# Основной URL для текущего окружения
BASE_URL=https://preprod.softmg.ru

# Альтернативные URL
DEV_BASE_URL=https://dev-01.matras.ru/
STAGE_BASE_URL=https://www.stage-01.matras.ru/
PROD_BASE_URL=https://www.matras.ru/

# Дефолтный юзер-агент
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/115.0.0.0 Safari/537.36"

# Дефолтная версия браузера
DEFAULT_BROWSER_VERSION=127.0

X_STAGE_NETWORK_TYPE=

RUN_MARKER=open_menu_new

BROWSER_NAME=chrome